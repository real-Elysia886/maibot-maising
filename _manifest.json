{
  "manifest_version": 2,
  "id": "elysia.sing.plugin",
  "name": "MaiSing · 麦麦想唱歌",
  "version": "1.0.0",
  "description": "通过独立推理服务生成 AI 演唱片段，支持歌曲检索、人声分离、RVC 音色转换、自动变调与混音。",
  "author": {
    "name": "real-Elysia886",
    "url": "https://github.com/real-Elysia886"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/real-Elysia886/mailbot-maising",
    "homepage": "https://github.com/real-Elysia886/mailbot-maising",
    "documentation": "https://github.com/real-Elysia886/mailbot-maising#readme"
  },
  "host_application": {
    "min_version": "1.3.17",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.19.0",
    "max_version": "2.19.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.8.0"
    }
  ],
  "plugin_type": "extension",
  "capabilities": [
    "send.text",
    "send.custom"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "music"
    }
  }
}
